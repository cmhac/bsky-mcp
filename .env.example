# Copy to .env for local development. Never commit .env.
# In Vercel, every variable marked SECRET must be stored as a "Secret" environment variable.

# Bluesky (required in production only)
BLUESKY_HANDLE=                 # e.g. you.bsky.social
BLUESKY_APP_PASSWORD=           # SECRET. An app password, never your main password
BLUESKY_SERVICE=                # optional, default https://bsky.social

# GitHub OAuth app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=           # SECRET
ALLOWED_GITHUB_USER_IDS=        # comma-separated numeric GitHub user IDs

# Server
BASE_URL=                       # public https URL of the deployment, no trailing slash
JWT_SIGNING_KEY=                # SECRET. base64 of 32+ random bytes
STORAGE_ENCRYPTION_KEY=         # SECRET. Fernet key (urlsafe base64 of 32 bytes)
REDIS_URL=                      # SECRET. rediss:// URL of the OAuth state store

# Network
ALLOWED_IP_RANGES=              # optional, default 160.79.104.0/21 (Anthropic outbound)
IP_ALLOWLIST_EXEMPT_PATHS=      # optional, default: browser sign-in routes only
ALLOWED_CLIENT_REDIRECT_URIS=   # optional, default: Claude's connector callback

# Reduce security. Leave false.
UNSAFE_DISABLE_OAUTH=           # optional, default false
UNSAFE_DISABLE_IP_ALLOWLIST=    # optional, default false

LOG_LEVEL=                      # optional, default INFO
